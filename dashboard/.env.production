# Non-secret defaults inlined into the client bundle by `next build` /
# `pages:build`. Without this file a clean checkout ships a bundle where
# ConvexClientProvider sees NEXT_PUBLIC_CONVEX_URL=undefined and silently
# disables sessions/clips/recordings persistence — the wrangler.toml [vars]
# binding only exists at runtime and cannot fix a build-time inline.
# Never put secrets here: NEXT_PUBLIC_* values ship to every browser.
NEXT_PUBLIC_CONVEX_URL=https://sleek-opossum-939.convex.cloud
NEXT_PUBLIC_TWITCH_CHANNEL=510coast
# Public Twitch app client id (safe to ship; the secret stays server-side for /api/twitch).
NEXT_PUBLIC_TWITCH_CLIENT_ID=wjx7dlnw7o242psisgylakohajg5z2
# GMI model routing defaults. The API key is a Convex deployment secret, never a client var.
GMI_COORDINATOR_MODEL=openai/gpt-6-astra
GMI_WORKER_MODEL=zai-org/GLM-5.3-Flash
